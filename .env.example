# ============================================================
#  环境变量模板 — 复制为 .env 并填入实际值
#  cp .env.example .env
#
#  ⚠️ PHASE100 T1: 所有 CHANGEME_* 占位符必须替换为强密码/随机密钥后才能部署生产。
#     deploy.sh prod 检测到默认口令会直接阻断（exit 1）。
#     强密码生成：openssl rand -base64 24
# ============================================================

# 数据库（生产必须 16+ 位随机）
POSTGRES_PASSWORD=CHANGEME_postgres_password

# Redis（默认无密码，生产建议配置 REDIS_PASSWORD）

# MinIO
MINIO_ROOT_USER=CHANGEME_minio_root_user
MINIO_ROOT_PASSWORD=CHANGEME_minio_password

# JWT（生产用 KMS 生成的 32+ 字符随机字符串）
JWT_SECRET=CHANGEME_jwt_secret_32_plus_chars

# RabbitMQ（guest 用户禁止远程连接，必须建独立账号）
RABBITMQ_USER=CHANGEME_rabbitmq_user
RABBITMQ_PASSWORD=CHANGEME_rabbitmq_password

# PHASE99 T1: 集成凭证加密主密钥（AES-256，Base64 32 字节）
# 生成：openssl rand -base64 32；未配置时 CredentialCryptoService 启动即失败
INTEGRATION_CREDENTIAL_MASTER_KEY=CHANGEME_integration_master_key

# PHASE100 T6: 告警 webhook（未配置则告警仅落盘不外发，启动日志会明确提示）
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_KIND=generic
ALERT_WEBHOOK_SECRET=

# 开发用固定值
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Java 后端
JAVA_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Python 后端
PYTHON_PORT=8000

# 前端
FRONTEND_PORT=5173

# LLM(阶段 4+ 用)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
