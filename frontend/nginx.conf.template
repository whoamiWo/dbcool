# ============================================================
#  NocoBase 前端 — Nginx 配置模板（PHASE114 双模式）
#  容器启动时由 docker-entrypoint.sh 用 envsubst 渲染为 nginx.conf
#
#  模式判定（由 entrypoint 注入）：
#    ENABLE_TLS=1 → 域名模式：80 跳转 443 + 443 ssl + HSTS
#    ENABLE_TLS=0 → IP 直连模式：仅 80 HTTP，无 TLS
#
#  变量（entrypoint 提供）：
#    SERVER_NAME        : 域名 或 "_"（IP 模式）
#    ENABLE_TLS         : "1" 或 "0"
# ============================================================

# ---------- HTTP 80 server 块 ----------
# 域名模式：永久 301 跳转 https + HSTS
# IP 模式：直接服务静态资源 + 反代
server {
    listen 80;
    server_name ${SERVER_NAME};
__IF_TLS__
    # PHASE100 T3: 80 → 443 永久跳转
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    # PHASE115 安全响应头（域名模式 80 跳转页也需发送）
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # CSP 说明（PHASE129 收紧）：
    #   default-src 'self' —— 默认所有资源仅同源
    #   script-src 'self' 'unsafe-inline' —— PHASE129 移除 'unsafe-eval'：
    #     dist/assets/*.js 实测 eval(/Function(/new Function( 命中数为 0（仅 Prism 语法高亮
    #     的关键字正则字符串字面量误匹配，非执行代码），移除后无任何运行时影响
    #   style-src 'self' 'unsafe-inline' —— 样式库运行时会注入 <style> 标签，暂留；
    #     阶段二迁移路径：构建期生成 nonce 注入 index.html + 渲染到响应头，再移除
    #   connect-src 'self' —— PHASE129 由 'self' wss: ws: 收窄为 'self'：
    #     wss:/ws: 是 scheme 级通配（允许任意主机的 ws），同源 WebSocket 用 'self' 即可覆盖
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self';" always;
    return 301 https://$host$request_uri;
__ELSE__
    # IP 直连模式：80 直接服务
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # PHASE115 安全响应头（IP 模式也需发送）
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # CSP 说明（PHASE129 收紧）：
    #   default-src 'self' —— 默认所有资源仅同源
    #   script-src 'self' 'unsafe-inline' —— PHASE129 移除 'unsafe-eval'：
    #     dist/assets/*.js 实测 eval(/Function(/new Function( 命中数为 0（仅 Prism 语法高亮
    #     的关键字正则字符串字面量误匹配，非执行代码），移除后无任何运行时影响
    #   style-src 'self' 'unsafe-inline' —— 样式库运行时会注入 <style> 标签，暂留；
    #     阶段二迁移路径：构建期生成 nonce 注入 index.html + 渲染到响应头，再移除
    #   connect-src 'self' —— PHASE129 由 'self' wss: ws: 收窄为 'self'：
    #     wss:/ws: 是 scheme 级通配（允许任意主机的 ws），同源 WebSocket 用 'self' 即可覆盖
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self';" always;

    # Java 后端
    location /api/ {
        proxy_pass http://backend-java:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Python 后端（AI 端点）
    location /api/ai/ {
        proxy_pass http://backend-python:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 静态资源
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        # 本块有 add_header，会阻断 server 级安全头继承，故此处重复声明
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        # CSP 说明（PHASE129 收紧）：
        #   default-src 'self' —— 默认所有资源仅同源
        #   script-src 'self' 'unsafe-inline' —— PHASE129 移除 'unsafe-eval'：
        #     dist/assets/*.js 实测 eval(/Function(/new Function( 命中数为 0，移除后无运行时影响
        #   style-src 'self' 'unsafe-inline' —— 样式库运行时会注入 <style> 标签，暂留；
        #     阶段二迁移路径：构建期生成 nonce 注入 index.html + 渲染到响应头，再移除
        #   connect-src 'self' —— PHASE129 由 'self' wss: ws: 收窄为 'self'（同源 WebSocket 用 'self' 覆盖）
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self';" always;
        try_files $uri =404;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # PHASE100 T3: 真实探活 —— 后端挂掉时返回 502，不是假 200
    location /health {
        proxy_pass http://backend-java:8080/api/health;
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        access_log off;
    }
__ENDIF__
}

__TLS_BLOCK__
