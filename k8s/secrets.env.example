# 第三方平台与基础设施凭证 —— 明文输入（**此文件模式已 gitignore：k8s/secrets.env 绝不入库**）
# 用法：cp k8s/secrets.env.example k8s/secrets.env 后填真实值，
#       再执行 bash scripts/seal-secrets.sh 生成可入库的 SealedSecret。
# 格式：KEY=value（每行一个，# 开头为注释）——与 docker-compose/.env 语义一致。

# 数据库 / 中间件
POSTGRES_USER=nocobase
POSTGRES_PASSWORD=
JWT_SECRET=
MINIO_ROOT_USER=nocobase
MINIO_ROOT_PASSWORD=
RABBITMQ_USER=nocobase
RABBITMQ_PASSWORD=

# 钉钉
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# 飞书
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=

# 企业微信
WECOM_CORP_ID=
WECOM_SECRET=

# 微信
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
