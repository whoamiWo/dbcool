# ============================================================
#  本地开发（源码构建）环境变量样例
#  cp .env.dev.example .env.dev
#
#  ⚠️ 仅用于本机开发：口令全是弱值，禁止用于生产。
#  生产部署请用 .env.example（APP_VERSION 必须是已发布镜像 tag）。
#
#  启动：
#    docker compose -f docker-compose.yml -f docker-compose.dev-build.yml \
#      --env-file .env.dev up -d --build
# ============================================================

# 源码构建使用的本地 tag（不是发布版本）
APP_VERSION=dev

POSTGRES_PASSWORD=dev_password
POSTGRES_USER=nocobase
POSTGRES_DB=nocobase

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

RABBITMQ_USER=nocobase
RABBITMQ_PASSWORD=dev_password

JWT_SECRET=dev_jwt_secret_change_me_32_chars_min
INTERNAL_SERVICE_TOKEN=dev_internal_service_token

# 开发环境用固定占位 key（32 字节 Base64；生产必须走 KMS / 随机生成）
INTEGRATION_CREDENTIAL_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

JAVA_PORT=8080
PYTHON_PORT=8000
CRDT_PORT=3100
FRONTEND_PORT=80
FRONTEND_TLS_PORT=443
FRONTEND_BIND_ADDR=127.0.0.1
PUBLIC_HOST=
